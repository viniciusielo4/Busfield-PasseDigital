# Copie para .env e ajuste os valores. Nunca versione o arquivo .env.
NODE_ENV=development
PORT=3000

# Conexão com o PostgreSQL (mesmos dados do docker-compose.yml)
DATABASE_URL=postgres://busfield:busfield@localhost:5432/busfield_pass

# Se usar um banco na nuvem (ex.: Supabase), troque a URL acima pela do provedor e ative:
DATABASE_SSL=false

# Segredo do JWT: mínimo de 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12

# Origem permitida no CORS (use o endereço do app/painel em produção)
CORS_ORIGIN=*

# Somente desenvolvimento: devolve o token de recuperação de senha na resposta
# (no MVP ainda não há envio de e-mail). Mantenha false em produção.
EXPOSE_RESET_TOKEN=true

# Usados por "npm run seed" para criar o primeiro administrador (opcional)
ADMIN_EMAIL=admin@busfield.local
ADMIN_PASSWORD=troque-esta-senha

# Banco usado pelos testes automatizados (o nome DEVE conter "test")
TEST_DATABASE_URL=postgres://busfield:busfield@localhost:5432/busfield_pass_test
